{
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter pbvm-cli run dev",
    "dev:docs": "pnpm --filter documentation run start",
    "dev:docs:zh": "pnpm --filter documentation run start:zh",
    "dev:pbvm-cli": "npm run dev",
    "build": "npm run build:pbvm-cli && npm run build:mermaid-prerender",
    "build:docs": "pnpm --filter documentation build",
    "build:mermaid-prerender": "pnpm --filter mermaid-prerender run build",
    "build:pbvm-cli": "pnpm --filter pbvm-cli run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:all": "pnpm lint && pnpm --filter pbvm-cli run lint && pnpm --filter mermaid-prerender run lint && pnpm --filter documentation run typecheck",
    "lint:fix": "oxlint --fix",
    "prepare": "npx husky install",
    "release": "pnpm --filter pbvm-cli publish",
    "release:mermaid-prerender": "pnpm --filter mermaid-prerender publish",
    "release:pbvm-cli": "npm run release",
    "start": "pnpm --filter pbvm-cli start",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/commander": "^2.12.5",
    "@types/node": "^26.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,md}": [
      "oxfmt --write"
    ],
    "packages/pbvm-cli/README.md": "node -e \"require('fs').cpSync('packages/pbvm-cli/README.md','README.md')\"",
    "packages/pbvm-cli/LICENSE": "node -e \"require('fs').cpSync('packages/pbvm-cli/LICENSE','LICENSE')\"",
    "packages/pbvm-cli/src/**/*.ts": "sh -c 'tsc -p packages/pbvm-cli/tsconfig.json --noEmit'",
    "packages/mermaid-prerender/src/**/*.ts": "sh -c 'tsc -p packages/mermaid-prerender/tsconfig.json --noEmit'"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.25.0"
}
