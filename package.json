{
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter pbvm run dev",
    "dev:docs": "pnpm --filter documentation run start",
    "dev:docs:zh": "pnpm --filter documentation run start:zh",
    "dev:pbvm": "npm run dev",
    "build": "pnpm --filter pbvm run build",
    "build:docs": "pnpm --filter documentation build",
    "build:mermaid-prerender": "pnpm --filter mermaid-prerender run build",
    "build:pbvm": "npm run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint && tsc --noEmit",
    "lint:fix": "oxlint --fix",
    "prepare": "npx husky install",
    "release": "pnpm --filter pbvm publish",
    "release:mermaid-prerender": "pnpm --filter mermaid-prerender publish",
    "release:pbvm": "npm run release",
    "start": "pnpm --filter pbvm start",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/commander": "^2.12.5",
    "@types/node": "^26.1.1",
    "husk": "^0.5.3",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,md}": [
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.25.0"
}
