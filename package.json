{
  "name": "pbvm",
  "version": "0.0.1",
  "description": "基于 @puppeteer/browsers 浏览器版本管理器",
  "type": "module",
  "bin": {
    "pbvm": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "docs:build": "pnpm --filter documentation build",
    "docs:dev": "pnpm --filter documentation start",
    "build": "tsc",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint && tsc --noEmit",
    "lint:fix": "oxlint --fix",
    "prepare": "npx husky install",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "puppeteer",
    "browsers",
    "chrome",
    "chromium",
    "firefox"
  ],
  "author": "levi<cgfeel@gmail.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.25.0",
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,md}": [
      "oxfmt --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@types/commander": "^2.12.5",
    "@types/node": "^26.1.1",
    "husk": "^0.5.3",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@puppeteer/browsers": "^3.0.6",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "ora": "^9.4.1",
    "zod": "^4.4.3"
  }
}
