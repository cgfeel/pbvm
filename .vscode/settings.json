{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "oxc.fixOnSave": true,
  // 忽略 CSS 中的 @theme 未知指令提示
  "css.lint.unknownAtRules": "ignore",
  // 若使用 SCSS/Sass，补充对应配置
  "scss.lint.unknownAtRules": "ignore"
}
