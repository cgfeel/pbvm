{
  "name": "pbvm-cli",
  "version": "1.0.42",
  "description": "A browser version manager built on @puppeteer/browsers, unified management of multiple versions of Chrome, Chromium, and Firefox.",
  "type": "module",
  "bin": {
    "pbvm": "./dist/index.js"
  },
  "main": "./dist/api.js",
  "types": "./dist/api.d.ts",
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "lint": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "release": "pnpm publish",
    "start": "node dist/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "puppeteer",
    "browsers",
    "chrome",
    "chromium",
    "firefox"
  ],
  "files": [
    "dist",
    "public",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "author": "levi<cgfeel@gmail.com>",
  "homepage": "https://cgfeel.github.io/pbvm/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgfeel/pbvm.git"
  },
  "bugs": {
    "url": "https://github.com/cgfeel/pbvm/issues",
    "email": "cgfeel@gmail.com"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/commander": "^2.12.5",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@puppeteer/browsers": "^3.0.6",
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "env-paths": "^4.0.0",
    "ora": "^9.4.1",
    "zod": "^4.4.3"
  }
}
