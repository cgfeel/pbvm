{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "rootDir": "./src/scripts",
    "outDir": "./node_modules/.cache/scripts",
    "types": ["node"],
    "noEmit": false
  },
  "include": ["src/scripts/**/*.ts"]
}
